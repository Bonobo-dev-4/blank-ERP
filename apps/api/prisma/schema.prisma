model JobWorkOrder {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @db.Uuid
  jobWorkOrderNo       String
  manufacturingOrderId String             @db.Uuid
  jobWorkerId          String             @db.Uuid
  productionStageId    String             @db.Uuid
  status               JobWorkOrderStatus @default(DRAFT)
  assignedQty          Decimal            @default(0) @db.Decimal(18, 4)
  issuedQty            Decimal            @default(0) @db.Decimal(18, 4)
  receivedQty          Decimal            @default(0) @db.Decimal(18, 4)
  completedQty         Decimal            @default(0) @db.Decimal(18, 4)
  rejectedQty          Decimal            @default(0) @db.Decimal(18, 4)
  reworkQty            Decimal            @default(0) @db.Decimal(18, 4)
  ratePerPiece         Decimal            @default(0) @db.Decimal(18, 6)
  totalCharge          Decimal            @default(0) @db.Decimal(18, 2)
  issueDate            DateTime?
  dueDate              DateTime?
  completionDate       DateTime?
  remarks              String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  manufacturingOrder ManufacturingOrder @relation(fields: [manufacturingOrderId], references: [id], onDelete: Cascade)
  jobWorker          JobWorker          @relation(fields: [jobWorkerId], references: [id])
  productionStage    ProductionStage    @relation(fields: [productionStageId], references: [id])
  lines              JobWorkOrderLine[]
  materialIssues     MaterialIssue[]

  @@unique([organizationId, jobWorkOrderNo])
  @@index([jobWorkerId, status])
  @@index([manufacturingOrderId])
  @@map("job_work_orders")
}

model JobWorkOrderLine {
  id                String   @id @default(uuid()) @db.Uuid
  jobWorkOrderId    String   @db.Uuid
  productionBatchId String   @db.Uuid
  assignedQty       Decimal  @db.Decimal(18, 4)
  receivedQty       Decimal  @default(0) @db.Decimal(18, 4)
  completedQty      Decimal  @default(0) @db.Decimal(18, 4)
  rejectedQty       Decimal  @default(0) @db.Decimal(18, 4)
  reworkQty         Decimal  @default(0) @db.Decimal(18, 4)
  ratePerPiece      Decimal  @default(0) @db.Decimal(18, 6)
  lineCharge        Decimal  @default(0) @db.Decimal(18, 2)
  createdAt         DateTime @default(now())

  jobWorkOrder    JobWorkOrder    @relation(fields: [jobWorkOrderId], references: [id], onDelete: Cascade)
  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id])

  @@unique([jobWorkOrderId, productionBatchId])
  @@map("job_work_order_lines")
}

// =============================================================================
// QUALITY CONTROL
// =============================================================================

model QualityInspection {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @db.Uuid
  inspectionNo         String
  kind                 QcKind
  manufacturingOrderId String           @db.Uuid
  productionBatchId    String?          @db.Uuid
  productionUnitId     String?          @db.Uuid
  stageTaskId          String?          @db.Uuid
  productionStageId    String?          @db.Uuid
  inspectedQty         Decimal          @db.Decimal(18, 4)
  passedQty            Decimal          @default(0) @db.Decimal(18, 4)
  failedQty            Decimal          @default(0) @db.Decimal(18, 4)
  reworkQty            Decimal          @default(0) @db.Decimal(18, 4)
  holdQty              Decimal          @default(0) @db.Decimal(18, 4)
  result               InspectionResult
  /// Filled checklist: [{ code, label, expected, observed, result }]
  checklist            Json             @default("[]")
  photoUrls            String[]         @default([])
  /// Set when this inspection re-checks an earlier one.
  reinspectionOfId     String?          @db.Uuid
  inspectorUserId      String?          @db.Uuid
  inspectedAt          DateTime         @default(now())
  remarks              String?
  idempotencyKey       String?
  createdAt            DateTime         @default(now())

  manufacturingOrder ManufacturingOrder   @relation(fields: [manufacturingOrderId], references: [id], onDelete: Cascade)
  productionBatch    ProductionBatch?     @relation(fields: [productionBatchId], references: [id])
  productionUnit     ProductionUnit?      @relation(fields: [productionUnitId], references: [id])
  stageTask          ProductionStageTask? @relation(fields: [stageTaskId], references: [id])
  productionStage    ProductionStage?     @relation(fields: [productionStageId], references: [id])
  reinspectionOf     QualityInspection?   @relation("Reinspection", fields: [reinspectionOfId], references: [id])
  reinspections      QualityInspection[]  @relation("Reinspection")
  defects            QualityDefect[]
  reworkOrders       ReworkOrder[]

  @@unique([organizationId, inspectionNo])
  @@unique([organizationId, idempotencyKey])
  @@index([manufacturingOrderId, kind])
  @@index([productionBatchId])
  @@map("quality_inspections")
}

model QualityDefect {
  id                  String         @id @default(uuid()) @db.Uuid
  qualityInspectionId String         @db.Uuid
  category            DefectCategory
  defectCode          String?
  description         String?
  qty                 Decimal        @db.Decimal(18, 4)
  severity            String?
  photoUrls           String[]       @default([])
  attributedStageId   String?        @db.Uuid
  attributedJobWorkerId String?      @db.Uuid
  createdAt           DateTime       @default(now())

  qualityInspection QualityInspection @relation(fields: [qualityInspectionId], references: [id], onDelete: Cascade)

  @@index([qualityInspectionId])
  @@index([category])
  @@map("quality_defects")
}

model ReworkOrder {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String            @db.Uuid
  reworkOrderNo       String
  qualityInspectionId String?           @db.Uuid
  productionBatchId   String            @db.Uuid
  /// Stage the quantity is routed back to.
  targetStageId       String?           @db.Uuid
  assignedJobWorkerId String?           @db.Uuid
  assignedUserId      String?           @db.Uuid
  qty                 Decimal           @db.Decimal(18, 4)
  completedQty        Decimal           @default(0) @db.Decimal(18, 4)
  scrappedQty         Decimal           @default(0) @db.Decimal(18, 4)
  status              ReworkOrderStatus @default(OPEN)
  reason              String?
  dueDate             DateTime?
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  qualityInspection QualityInspection? @relation(fields: [qualityInspectionId], references: [id])
  productionBatch   ProductionBatch    @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  assignedJobWorker JobWorker?         @relation(fields: [assignedJobWorkerId], references: [id])

  @@unique([organizationId, reworkOrderNo])
  @@index([productionBatchId, status])
  @@map("rework_orders")
}

// =============================================================================
// FINISHED GOODS
// -----------------------------------------------------------------------------
// Only QC-approved quantity can be inwarded, and inward can never exceed
// (qcPassedQty - alreadyInwardedQty) for the batch. The push to Unicommerce is
// a separate, explicitly approved step tracked per inward line.
// =============================================================================

model FinishedGoodsBalance {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  productVariantId String   @db.Uuid
  locationId       String   @db.Uuid
  onHandQty        Decimal  @default(0) @db.Decimal(18, 4)
  /// Quantity inwarded in the ERP but not yet confirmed in Unicommerce.
  pendingSyncQty   Decimal  @default(0) @db.Decimal(18, 4)
  syncedQty        Decimal  @default(0) @db.Decimal(18, 4)
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt

  productVariant ProductVariant   @relation(fields: [productVariantId], references: [id])
  location       MaterialLocation @relation(fields: [locationId], references: [id])

  @@unique([productVariantId, locationId])
  @@index([organizationId, productVariantId])
  @@map("finished_goods_balances")
}

model FinishedGoodsMovement {
  id               String                    @id @default(uuid()) @db.Uuid
  organizationId   String                    @db.Uuid
  movementNo       String
  movementType     FinishedGoodsMovementType
  productVariantId String                    @db.Uuid
  sourceLocationId String?                   @db.Uuid
  destinationLocationId String?              @db.Uuid
  qty              Decimal                   @db.Decimal(18, 4)
  unitCost         Decimal?                  @db.Decimal(18, 6)
  referenceType    String?
  referenceId      String?                   @db.Uuid
  referenceNo      String?
  operatorUserId   String?                   @db.Uuid
  reason           String?
  idempotencyKey   String
  occurredAt       DateTime                  @default(now())
  createdAt        DateTime                  @default(now())

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([organizationId, movementNo])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, productVariantId, occurredAt])
  @@index([referenceType, referenceId])
  @@map("finished_goods_movements")
}

model FinishedGoodsInward {
  id                   String     @id @default(uuid()) @db.Uuid
  organizationId       String     @db.Uuid
  inwardNo             String
  manufacturingOrderId String     @db.Uuid
  manufacturingLocationId String  @db.Uuid
  destinationFacilityId String?   @db.Uuid
  inwardDate           DateTime   @default(now())
  status               String     @default("DRAFT")
  syncStatus           SyncStatus @default(SYNC_PENDING)
  inwardByUserId       String?    @db.Uuid
  postedAt             DateTime?
  remarks              String?
  idempotencyKey       String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  manufacturingOrder    ManufacturingOrder        @relation(fields: [manufacturingOrderId], references: [id], onDelete: Cascade)
  manufacturingLocation MaterialLocation          @relation(fields: [manufacturingLocationId], references: [id])
  destinationFacility   ExternalFacility?         @relation(fields: [destinationFacilityId], references: [id])
  lines                 FinishedGoodsInwardLine[]
  barcode               BarcodeIdentifier?        @relation("InwardBarcode")

  @@unique([organizationId, inwardNo])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, syncStatus])
  @@index([manufacturingOrderId])
  @@map("finished_goods_inwards")
}

model FinishedGoodsInwardLine {
  id                 String   @id @default(uuid()) @db.Uuid
  finishedInwardId   String   @db.Uuid
  lineNo             Int
  productVariantId   String   @db.Uuid
  productionBatchId  String?  @db.Uuid
  acceptedQty        Decimal  @db.Decimal(18, 4)
  rejectedQty        Decimal  @default(0) @db.Decimal(18, 4)
  /// Serial numbers inwarded, when the batch is unit-tracked.
  unitIds            String[] @default([])
  unitCost           Decimal? @db.Decimal(18, 6)
  /// Quantity already accepted by Unicommerce. Guarded so the same quantity is
  /// never credited to external inventory twice.
  pushedQty          Decimal  @default(0) @db.Decimal(18, 4)
  movementId         String?  @db.Uuid
  version            Int      @default(0)
  remarks            String?

  finishedInward  FinishedGoodsInward @relation(fields: [finishedInwardId], references: [id], onDelete: Cascade)
  productVariant  ProductVariant      @relation(fields: [productVariantId], references: [id])
  productionBatch ProductionBatch?    @relation(fields: [productionBatchId], references: [id])
  pushLines       InventoryPushLine[]

  @@unique([finishedInwardId, lineNo])
  @@index([productVariantId])
  @@index([productionBatchId])
  @@map("finished_goods_inward_lines")
}

// =============================================================================
// EXTERNAL FACILITIES AND UNICOMMERCE INVENTORY PUSH
// -----------------------------------------------------------------------------
// A push job is an immutable transaction record. The externalRequestId is
// generated by the ERP and sent with the call so a retry is idempotent on the
// external side too. Success is decided by the BUSINESS response, never by the
// HTTP status; an uncertain outcome goes to RECONCILIATION_REQUIRED and is
// never auto-retried.
// =============================================================================

model ExternalFacility {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  provider       IntegrationProvider
  /// Exact external facility identifier, preserved verbatim.
  externalCode   String
  externalName   String?
  displayName    String
  /// Internal location that mirrors this facility, when one exists.
  mirrorLocationId String?           @db.Uuid
  isDefault      Boolean             @default(false)
  /// Pushes are blocked unless the facility has been explicitly approved.
  isPushEnabled  Boolean             @default(false)
  address        Json?
  rawPayload     Json?
  status         RecordStatus        @default(ACTIVE)
  syncedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization    Organization                      @relation(fields: [organizationId], references: [id])
  pushJobs        InventoryPushJob[]
  inwards         FinishedGoodsInward[]
  demands         ManufacturingDemand[]
  orders          ManufacturingOrder[]
  reconciliations ExternalInventoryReconciliation[]
  inventorySnapshots FacilityInventorySnapshot[]
  unicommercePos  UnicommercePurchaseOrder[]
  forecasts       DemandForecast[]
  replenishments  ReplenishmentSuggestion[]

  @@unique([organizationId, provider, externalCode])
  @@index([organizationId, provider, status])
  @@map("external_facilities")
}

model InventoryPushJob {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String            @db.Uuid
  pushJobNo           String
  provider            IntegrationProvider @default(UNICOMMERCE)
  operationKind       PushOperationKind
  externalFacilityId  String            @db.Uuid
  status              PushJobStatus     @default(DRAFT)
  /// Client-generated id sent to the external API for its own de-duplication.
  externalRequestId   String
  /// External reference returned on success (e.g. the Unicommerce GRN number).
  externalReference   String?
  totalQty            Decimal           @default(0) @db.Decimal(18, 4)
  successQty          Decimal           @default(0) @db.Decimal(18, 4)
  failedQty           Decimal           @default(0) @db.Decimal(18, 4)
  attemptCount        Int               @default(0)
  lastAttemptAt       DateTime?
  /// Verbatim request and business response, for audit and dispute handling.
  requestPayload      Json?
  responsePayload     Json?
  errorCode           String?
  errorMessage        String?
  /// Set when an operator changed the destination facility; requires approval.
  facilityChangeApprovedByUserId String? @db.Uuid
  previewedByUserId   String?           @db.Uuid
  approvedByUserId    String?           @db.Uuid
  approvedAt          DateTime?
  queuedAt            DateTime?
  completedAt         DateTime?
  idempotencyKey      String
  createdByUserId     String?           @db.Uuid
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  externalFacility ExternalFacility                  @relation(fields: [externalFacilityId], references: [id])
  lines            InventoryPushLine[]
  reconciliations  ExternalInventoryReconciliation[]

  @@unique([organizationId, pushJobNo])
  @@unique([organizationId, externalRequestId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@map("inventory_push_jobs")
}

model InventoryPushLine {
  id                  String     @id @default(uuid()) @db.Uuid
  inventoryPushJobId  String     @db.Uuid
  lineNo              Int
  finishedInwardLineId String    @db.Uuid
  productVariantId    String     @db.Uuid
  /// External SKU resolved at preview time; a push with a null value is refused.
  externalSku         String?
  qty                 Decimal    @db.Decimal(18, 4)
  acceptedQty         Decimal    @default(0) @db.Decimal(18, 4)
  status              SyncStatus @default(SYNC_PENDING)
  externalLineRef     String?
  errorCode           String?
  errorMessage        String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  inventoryPushJob   InventoryPushJob        @relation(fields: [inventoryPushJobId], references: [id], onDelete: Cascade)
  finishedInwardLine FinishedGoodsInwardLine @relation(fields: [finishedInwardLineId], references: [id])

  @@unique([inventoryPushJobId, lineNo])
  /// One inward line can appear at most once per push job.
  @@unique([inventoryPushJobId, finishedInwardLineId])
  @@index([finishedInwardLineId])
  @@map("inventory_push_lines")
}

/// Point-in-time comparison of ERP quantity against the quantity the external
/// system actually reports. Nothing is marked reconciled without this record.
model ExternalInventoryReconciliation {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  provider           IntegrationProvider
  externalFacilityId String              @db.Uuid
  productVariantId   String?             @db.Uuid
  inventoryPushJobId String?             @db.Uuid
  erpQty             Decimal             @db.Decimal(18, 4)
  externalQty        Decimal             @db.Decimal(18, 4)
  varianceQty        Decimal             @db.Decimal(18, 4)
  observedAt         DateTime            @default(now())
  resolution         String?
  resolvedByUserId   String?             @db.Uuid
  resolvedAt         DateTime?
  rawPayload         Json?
  createdAt          DateTime            @default(now())

  externalFacility ExternalFacility  @relation(fields: [externalFacilityId], references: [id])
  inventoryPushJob InventoryPushJob? @relation(fields: [inventoryPushJobId], references: [id])

  @@index([organizationId, externalFacilityId, observedAt])
  @@index([inventoryPushJobId])
  @@map("external_inventory_reconciliations")
}

// =============================================================================
// INTEGRATION PLUMBING
// =============================================================================

model IntegrationConnection {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  provider       IntegrationProvider
  name           String
  /// Non-secret configuration (shop domain, base url, api version, facility...).
  config         Json                @default("{}")
  /// Opaque reference to the secret in the configured secret store. Secrets are
  /// NEVER stored in this column or in this database in plaintext.
  credentialRef  String?
  /// Supported API version pinned for this connection.
  apiVersion     String?
  isEnabled      Boolean             @default(false)
  /// Blocks any write/mutating call to the external system.
  allowExternalWrites Boolean        @default(false)
  healthStatus   String              @default("UNKNOWN")
  lastHealthCheckAt DateTime?
  lastSyncAt     DateTime?
  rateLimitState Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  events       IntegrationEvent[]
  syncLogs     SyncLog[]

  @@unique([organizationId, provider, name])
  @@map("integration_connections")
}

/// Inbound webhook / polled event envelope. The unique external event id is the
/// guard against duplicate webhook deliveries.
model IntegrationEvent {
  id                      String                 @id @default(uuid()) @db.Uuid
  organizationId          String                 @db.Uuid
  integrationConnectionId String?                @db.Uuid
  provider                IntegrationProvider
  eventType               String
  externalEventId         String
  externalResourceId      String?
  payload                 Json
  headers                 Json?
  status                  IntegrationEventStatus @default(RECEIVED)
  attemptCount            Int                    @default(0)
  lastError               String?
  processedAt             DateTime?
  receivedAt              DateTime               @default(now())

  integrationConnection IntegrationConnection? @relation(fields: [integrationConnectionId], references: [id])

  @@unique([organizationId, provider, eventType, externalEventId])
  @@index([organizationId, status, receivedAt])
  @@map("integration_events")
}

/// One row per outbound external API call. Request and response are retained
/// so an uncertain outcome can be investigated and reconciled.
model SyncLog {
  id                      String              @id @default(uuid()) @db.Uuid
  organizationId          String              @db.Uuid
  integrationConnectionId String?             @db.Uuid
  provider                IntegrationProvider
  operation               String
  direction               String              @default("OUTBOUND")
  referenceType           String?
  referenceId             String?             @db.Uuid
  externalRequestId       String?
  httpStatus              Int?
  /// Business-level success flag parsed from the response body.
  businessSuccess         Boolean?
  requestPayload          Json?
  responsePayload         Json?
  errorCode               String?
  errorMessage            String?
  durationMs              Int?
  attemptNo               Int                 @default(1)
  /// True when the call timed out or the outcome could not be determined.
  outcomeUncertain        Boolean             @default(false)
  createdAt               DateTime            @default(now())

  integrationConnection IntegrationConnection? @relation(fields: [integrationConnectionId], references: [id])

  @@index([organizationId, provider, operation, createdAt])
  @@index([referenceType, referenceId])
  @@index([externalRequestId])
  @@map("sync_logs")
}

// =============================================================================
// COSTING
// =============================================================================

model MoCostEntry {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @db.Uuid
  manufacturingOrderId String   @db.Uuid
  /// MATERIAL / WASTAGE / CUTTING / EMBROIDERY / STITCHING / FINISHING /
  /// JOB_WORK / PACKAGING / OVERHEAD
  costCategory         String
  isPlanned            Boolean
  qty                  Decimal? @db.Decimal(18, 4)
  unitRate             Decimal? @db.Decimal(18, 6)
  amount               Decimal  @db.Decimal(18, 2)
  referenceType        String?
  referenceId          String?  @db.Uuid
  remarks              String?
  createdAt            DateTime @default(now())

  manufacturingOrder ManufacturingOrder @relation(fields: [manufacturingOrderId], references: [id], onDelete: Cascade)

  @@index([manufacturingOrderId, costCategory, isPlanned])
  @@map("mo_cost_entries")
}

// =============================================================================
// V3 ADDITIONS - ENUMS
// =============================================================================

enum FabricRollStatus {
  RECEIVED
  QC_PENDING
  AVAILABLE
  PARTIALLY_ISSUED
  ISSUED
  EXHAUSTED
  BLOCKED
  RETURNED_TO_SUPPLIER
}

/// Fulfilment readiness of one external order line, computed from a facility
/// stock snapshot. Availability is NOT a reservation.
enum InventoryAvailabilityStatus {
  PENDING_CHECK
  AVAILABLE
  PARTIALLY_AVAILABLE
  OUT_OF_STOCK
  ALLOCATION_PENDING
  ALLOCATION_CONFIRMED
  INVENTORY_CHECK_FAILED
}

enum ExternalOrderStatus {
  OPEN
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  CLOSED
  ON_HOLD
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SUPPRESSED_DUPLICATE
  READ
}

enum ForecastMethod {
  MOVING_AVERAGE
  WEIGHTED_VELOCITY
  SEASONAL_INDEX
  MANUAL_OVERRIDE
}

enum BundleComponentRole {
  PRIMARY
  COMPONENT
  ACCESSORY
}

// =============================================================================
// FABRIC ROLL MANAGEMENT  (V3 Section 7)
// -----------------------------------------------------------------------------
// A roll is a physically identifiable piece of one fabric lot, with its own
// barcode and its own length. Roll lengths are a projection of the ledger just
// like MaterialBalance: every roll movement stamps fabricRollId, so
//   SUM(FabricRoll.currentLength) for (material, lot, location)
//     == MaterialBalance.onHandQty for that key
// is a checkable invariant (see inventory-accounting.md).
// =============================================================================

model FabricRoll {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  rollNo         String
  rawMaterialId  String           @db.Uuid
  materialLotId  String           @db.Uuid
  locationId     String           @db.Uuid
  supplierId     String?          @db.Uuid
  receiptLineId  String?          @db.Uuid
  shade          String?
  color          String?
  width          Decimal?         @db.Decimal(10, 2)
  widthUom       String?
  gsm            Int?
  /// Length as received. Immutable.
  originalLength Decimal          @db.Decimal(18, 4)
  /// Physical length remaining on the roll right now.
  currentLength  Decimal          @db.Decimal(18, 4)
  /// Portion of currentLength committed to manufacturing orders.
  reservedLength Decimal          @default(0) @db.Decimal(18, 4)
  lengthUom      UomCode          @default(METER)
  purchaseRate   Decimal?         @db.Decimal(18, 6)
  qcStatus       InspectionResult?
  status         FabricRollStatus @default(RECEIVED)
  defectNotes    String?
  receivedAt     DateTime?
  version        Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  rawMaterial    RawMaterial             @relation(fields: [rawMaterialId], references: [id])
  materialLot    MaterialLot             @relation(fields: [materialLotId], references: [id])
  location       MaterialLocation        @relation(fields: [locationId], references: [id])
  supplier       Supplier?               @relation(fields: [supplierId], references: [id])
  receiptLine    RawMaterialReceiptLine? @relation(fields: [receiptLineId], references: [id])
  barcode        BarcodeIdentifier?      @relation("RollBarcode")
  issueLines     MaterialIssueLine[]
  movements      MaterialMovement[]
  consumptions   MaterialConsumption[]
  cuttingOrders  CuttingOrder[]

  @@unique([organizationId, rollNo])
  @@index([organizationId, rawMaterialId, status])
  @@index([materialLotId])
  @@index([locationId])
  @@map("fabric_rolls")
}

// =============================================================================
// PRODUCT BUNDLES  (V3 Section 3 / 22B)
// -----------------------------------------------------------------------------
// A bundle SKU (Set = Kurta + Pant + Dupatta) is assembled from component SKUs
// that each keep their own BOM and production route, so component-level
// material consumption and stage tracking stay intact.
// =============================================================================

model ProductBundleComponent {
  id                       String              @id @default(uuid()) @db.Uuid
  organizationId           String              @db.Uuid
  bundleVariantId          String              @db.Uuid
  componentVariantId       String              @db.Uuid
  qtyPerBundle             Decimal             @default(1) @db.Decimal(18, 4)
  role                     BundleComponentRole @default(COMPONENT)
  sequence                 Int                 @default(1)
  /// When true the component must be manufactured, not drawn from stock.
  requiresManufacturing    Boolean             @default(true)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  bundleVariant    ProductVariant @relation("BundleParent", fields: [bundleVariantId], references: [id], onDelete: Cascade)
  componentVariant ProductVariant @relation("BundleChild", fields: [componentVariantId], references: [id])

  @@unique([bundleVariantId, componentVariantId])
  @@index([componentVariantId])
  @@map("product_bundle_components")
}

// =============================================================================
// EXTERNAL ORDER INTELLIGENCE  (V3 Section 4)
// -----------------------------------------------------------------------------
// Raw imported order documents are stored verbatim and separately from
// ManufacturingDemand. Demand is DERIVED from these lines after the stock
// availability check; only the uncovered quantity becomes demand.
// =============================================================================

model ShopifyOrder {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  /// Shopify order GID, preserved verbatim.
  externalId         String
  orderNumber        String
  orderName          String?
  /// ONLINE / POS / CUSTOM / DRAFT - classified on import.
  channel            DemandChannel
  posLocationId      String?
  posLocationName    String?
  orderedAt          DateTime
  financialStatus    String?
  fulfillmentStatus  String?
  status             ExternalOrderStatus @default(OPEN)
  currency           String?
  totalAmount        Decimal?            @db.Decimal(18, 2)
  requiredByDate     DateTime?
  customerRef        String?
  note               String?
  tags               String[]            @default([])
  cancelledAt        DateTime?
  /// Verbatim payload of the last import, for audit and replay.
  rawPayload         Json?
  /// Shopify updated_at of the version we have processed, for stale-write guard.
  externalUpdatedAt  DateTime?
  importedAt         DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  lines ShopifyOrderLine[]

  @@unique([organizationId, externalId])
  @@index([organizationId, channel, orderedAt])
  @@index([organizationId, status])
  @@map("shopify_orders")
}

model ShopifyOrderLine {
  id                  String                      @id @default(uuid()) @db.Uuid
  organizationId      String                      @db.Uuid
  shopifyOrderId      String                      @db.Uuid
  /// Shopify line item GID, preserved verbatim.
  externalLineId      String
  productVariantId    String?                     @db.Uuid
  externalSku         String?
  externalVariantId   String?
  title               String?
  size                String?
  color               String?
  orderedQty          Decimal                     @db.Decimal(18, 4)
  cancelledQty        Decimal                     @default(0) @db.Decimal(18, 4)
  fulfilledQty        Decimal                     @default(0) @db.Decimal(18, 4)
  refundedQty         Decimal                     @default(0) @db.Decimal(18, 4)
  /// Result of the facility stock check. Availability != reservation.
  availabilityStatus  InventoryAvailabilityStatus @default(PENDING_CHECK)
  availableQty        Decimal                     @default(0) @db.Decimal(18, 4)
  /// Quantity an external allocation/reservation call actually confirmed.
  allocatedQty        Decimal                     @default(0) @db.Decimal(18, 4)
  /// orderedQty - cancelled - covered by confirmed stock.
  manufacturingQty    Decimal                     @default(0) @db.Decimal(18, 4)
  /// Timestamp of the snapshot the availability figures came from.
  availabilityCheckedAt DateTime?
  availabilityError   String?
  customization       Json?
  priority            Priority                    @default(NORMAL)
  rawPayload          Json?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  shopifyOrder ShopifyOrder @relation(fields: [shopifyOrderId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalLineId])
  @@index([shopifyOrderId])
  @@index([organizationId, availabilityStatus])
  @@index([productVariantId])
  @@map("shopify_order_lines")
}

model UnicommercePurchaseOrder {
  id                  String              @id @default(uuid()) @db.Uuid
  organizationId      String              @db.Uuid
  /// Unicommerce purchase order code, preserved verbatim.
  externalId          String
  poNumber            String
  poDate              DateTime
  supplierName        String?
  supplierCode        String?
  destinationFacilityId String?           @db.Uuid
  externalFacilityCode String?
  status              ExternalOrderStatus @default(OPEN)
  expectedDeliveryDate DateTime?
  totalQty            Decimal             @default(0) @db.Decimal(18, 4)
  receivedQty         Decimal             @default(0) @db.Decimal(18, 4)
  pendingQty          Decimal             @default(0) @db.Decimal(18, 4)
  /// Amendment counter from the external document, used for stale-write guard.
  externalVersion     String?
  rawPayload          Json?
  importedAt          DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  destinationFacility ExternalFacility?            @relation(fields: [destinationFacilityId], references: [id])
  lines               UnicommercePurchaseOrderLine[]

  @@unique([organizationId, externalId])
  @@index([organizationId, status, expectedDeliveryDate])
  @@map("unicommerce_purchase_orders")
}

model UnicommercePurchaseOrderLine {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @db.Uuid
  unicommercePoId      String   @db.Uuid
  /// External line identifier, preserved verbatim.
  externalLineId       String
  productVariantId     String?  @db.Uuid
  externalSku          String?
  itemName             String?
  size                 String?
  color                String?
  orderedQty           Decimal  @db.Decimal(18, 4)
  receivedQty          Decimal  @default(0) @db.Decimal(18, 4)
  pendingQty           Decimal  @default(0) @db.Decimal(18, 4)
  cancelledQty         Decimal  @default(0) @db.Decimal(18, 4)
  manufacturingQty     Decimal  @default(0) @db.Decimal(18, 4)
  expectedDeliveryDate DateTime?
  rawPayload           Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  unicommercePo UnicommercePurchaseOrder @relation(fields: [unicommercePoId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalLineId])
  @@index([unicommercePoId])
  @@index([productVariantId])
  @@map("unicommerce_purchase_order_lines")
}

/// Timestamped facility-level stock snapshot pulled from the external system.
/// A snapshot is evidence of availability at a moment - never a reservation.
model FacilityInventorySnapshot {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  externalFacilityId String   @db.Uuid
  productVariantId   String?  @db.Uuid
  externalSku        String?
  availableQty       Decimal  @db.Decimal(18, 4)
  reservedQty        Decimal  @default(0) @db.Decimal(18, 4)
  inTransitQty       Decimal  @default(0) @db.Decimal(18, 4)
  totalQty           Decimal  @default(0) @db.Decimal(18, 4)
  /// When the EXTERNAL system reported this figure.
  snapshotAt         DateTime
  fetchedAt          DateTime @default(now())
  rawPayload         Json?

  externalFacility ExternalFacility @relation(fields: [externalFacilityId], references: [id])

  @@index([organizationId, externalFacilityId, productVariantId, snapshotAt])
  @@index([organizationId, externalSku, snapshotAt])
  @@map("facility_inventory_snapshots")
}

// =============================================================================
// FORECASTING AND REPLENISHMENT  (V3 Section 20)
// -----------------------------------------------------------------------------
// Rule-based and transparent: every forecast row stores the inputs and the
// method used, so a planner can see exactly why a number was suggested.
// =============================================================================

model DemandForecast {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @db.Uuid
  productVariantId   String         @db.Uuid
  externalFacilityId String?        @db.Uuid
  periodStart        DateTime
  periodEnd          DateTime
  method             ForecastMethod @default(WEIGHTED_VELOCITY)
  /// Units sold per week over the look-back window.
  salesVelocity      Decimal        @default(0) @db.Decimal(18, 4)
  lookbackDays       Int            @default(56)
  seasonalIndex      Decimal        @default(1) @db.Decimal(9, 4)
  forecastQty        Decimal        @db.Decimal(18, 4)
  confidence         Decimal?       @db.Decimal(9, 4)
  /// All inputs used, so the figure is reproducible and explainable.
  inputs             Json           @default("{}")
  generatedByUserId  String?        @db.Uuid
  createdAt          DateTime       @default(now())

  externalFacility ExternalFacility? @relation(fields: [externalFacilityId], references: [id])

  @@unique([organizationId, productVariantId, externalFacilityId, periodStart, method])
  @@index([organizationId, periodStart])
  @@map("demand_forecasts")
}

model ReplenishmentSuggestion {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  productVariantId   String   @db.Uuid
  externalFacilityId String?  @db.Uuid
  demandForecastId   String?  @db.Uuid
  availableQty       Decimal  @default(0) @db.Decimal(18, 4)
  /// Already-confirmed incoming quantity (open MOs and confirmed transfers).
  incomingQty        Decimal  @default(0) @db.Decimal(18, 4)
  leadTimeDays       Int      @default(0)
  /// Expected demand over the lead-time horizon.
  leadTimeDemandQty  Decimal  @default(0) @db.Decimal(18, 4)
  safetyStockQty     Decimal  @default(0) @db.Decimal(18, 4)
  suggestedQty       Decimal  @db.Decimal(18, 4)
  rationale          String?
  status             String   @default("OPEN")
  actionedByUserId   String?  @db.Uuid
  actionedAt         DateTime?
  manufacturingOrderId String? @db.Uuid
  createdAt          DateTime @default(now())

  externalFacility ExternalFacility? @relation(fields: [externalFacilityId], references: [id])

  @@index([organizationId, status, createdAt])
  @@index([productVariantId])
  @@map("replenishment_suggestions")
}

// =============================================================================
// ALERTS AND NOTIFICATIONS  (V3 Section 19)
// =============================================================================

model AlertRule {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  code           String
  name           String
  /// LOW_STOCK / REORDER_POINT / ROLL_SHORTAGE / BOM_SHORTAGE /
  /// PRODUCTION_DELAY / PO_OVERDUE / JOB_WORKER_DELAY / QC_HOLD /
  /// HIGH_WASTAGE / SYNC_FAILED / RECONCILIATION_VARIANCE
  alertType      String
  severity       AlertSeverity @default(WARNING)
  /// Rule parameters, e.g. { "thresholdPct": 20, "graceDays": 2 }
  conditions     Json          @default("{}")
  channels       NotificationChannel[]
  /// Recipients by role code; resolved to users at send time.
  recipientRoles String[]      @default([])
  recipientUserIds String[]    @default([])
  /// Minimum minutes between two notifications for the same dedupe key.
  cooldownMinutes Int          @default(1440)
  isEnabled      Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  notifications Notification[]

  @@unique([organizationId, code])
  @@index([organizationId, alertType, isEnabled])
  @@map("alert_rules")
}

model Notification {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  alertRuleId    String?             @db.Uuid
  channel        NotificationChannel @default(IN_APP)
  severity       AlertSeverity       @default(INFO)
  title          String
  body           String
  /// Stable key over (rule, subject, bucket). Unique, so the same alert is not
  /// delivered twice within its cooldown window.
  dedupeKey      String
  recipientUserId String?            @db.Uuid
  recipientAddress String?
  entityType     String?
  entityId       String?
  actionUrl      String?
  status         NotificationStatus  @default(QUEUED)
  sentAt         DateTime?
  readAt         DateTime?
  failureReason  String?
  payload        Json?
  createdAt      DateTime            @default(now())

  alertRule AlertRule? @relation(fields: [alertRuleId], references: [id])

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, recipientUserId, status])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

// =============================================================================
// APPROVAL MATRIX  (V3 Section 22J)
// =============================================================================

model ApprovalRule {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  name           String
  /// PURCHASE_ORDER / STOCK_ADJUSTMENT / BOM_RELEASE / MATERIAL_SUBSTITUTION /
  /// SHORTAGE_RELEASE / SHADE_MIX / FACILITY_CHANGE / INVENTORY_PUSH
  subjectType    String
  /// Optional threshold that triggers the requirement, e.g. amount > 50000.
  conditions     Json     @default("{}")
  /// Role codes allowed to approve, in escalation order.
  approverRoles  String[] @default([])
  minApprovals   Int      @default(1)
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  requests ApprovalRequest[]

  @@unique([organizationId, code])
  @@index([organizationId, subjectType, isEnabled])
  @@map("approval_rules")
}

model ApprovalRequest {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  approvalRuleId  String?        @db.Uuid
  subjectType     String
  subjectId       String         @db.Uuid
  subjectRef      String?
  /// Snapshot of what is being approved, so the approver sees the exact state.
  requestPayload  Json           @default("{}")
  reason          String?
  status          ApprovalStatus @default(PENDING)
  requestedByUserId String?      @db.Uuid
  decidedByUserId String?        @db.Uuid
  decidedAt       DateTime?
  decisionNote    String?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  approvalRule ApprovalRule? @relation(fields: [approvalRuleId], references: [id])

  @@index([organizationId, status, subjectType])
  @@index([subjectType, subjectId])
  @@map("approval_requests")
}

// =============================================================================
// DOCUMENTS AND SAVED VIEWS
// =============================================================================

model DocumentAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  entityType     String
  entityId       String   @db.Uuid
  category       String?
  fileName       String
  contentType    String
  byteSize       Int
  /// Object-storage key. Binary content never lives in the database.
  storageKey     String
  checksumSha256 String?
  uploadedByUserId String? @db.Uuid
  createdAt      DateTime @default(now())

  @@index([organizationId, entityType, entityId])
  @@map("document_attachments")
}

model SavedView {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  ownerUserId    String?  @db.Uuid
  resource       String
  name           String
  /// Serialised filters, sort, column visibility and page size.
  definition     Json     @default("{}")
  isShared       Boolean  @default(false)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, ownerUserId, resource, name])
  @@index([organizationId, resource])
  @@map("saved_views")
}
