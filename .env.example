# ---------------------------------------------------------------------------
# DASH AND DOT MANUFACTURING ERP - environment template
# Copy to .env and fill in real values. NEVER commit a populated .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database --------------------------------------------------------------
# 127.0.0.1 rather than localhost on purpose: on macOS "localhost" resolves to
# ::1 first, and a server bound only to IPv4 then refuses the connection.
DATABASE_URL="postgresql://dnd:dnd@127.0.0.1:5432/dnd_erp?schema=public"
# Using the bundled PGlite server instead of Docker? Append:
#   &pgbouncer=true&connection_limit=1
# PGlite shares one backend session, so Prisma must not cache prepared statements.
# Used by `prisma migrate dev` for shadow-database diffing (optional).
SHADOW_DATABASE_URL="postgresql://dnd:dnd@127.0.0.1:5432/dnd_erp_shadow?schema=public"

# --- Redis / BullMQ --------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- API -------------------------------------------------------------------
API_PORT=3001
API_GLOBAL_PREFIX=api
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars-long"
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d
CORS_ORIGINS="http://localhost:3000"

# --- Object storage (S3 compatible: AWS S3, MinIO, Cloudflare R2) ----------
STORAGE_ENDPOINT=""
STORAGE_BUCKET="dnd-erp"
STORAGE_REGION="ap-south-1"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Default organisation created by the seed ------------------------------
SEED_ORG_CODE="DND"
SEED_ORG_NAME="Dash and Dot"
SEED_ADMIN_EMAIL="admin@dashanddot.local"
# If unset, the seed generates a random password and prints it once.
SEED_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# INTEGRATIONS
# Both connectors ship DISABLED and READ-ONLY. Writes to external inventory
# require INTEGRATION_ALLOW_EXTERNAL_WRITES=true AND a per-connection flag AND
# an approved push job. See docs/unicommerce-integration.md.
# ---------------------------------------------------------------------------
INTEGRATION_ALLOW_EXTERNAL_WRITES=false

# --- Shopify Admin API -----------------------------------------------------
SHOPIFY_ENABLED=false
SHOPIFY_SHOP_DOMAIN=""
SHOPIFY_ADMIN_API_VERSION="2025-07"
SHOPIFY_ADMIN_ACCESS_TOKEN=""
SHOPIFY_WEBHOOK_SECRET=""
# CRM fields read from Shopify - only sources the business has approved.
# Order metafield holding a dispatch date / a priority, as namespace.key.
SHOPIFY_DISPATCH_DATE_METAFIELD=""
SHOPIFY_PRIORITY_METAFIELD=""
# Approved tags that set priority: "tag:VIP|HIGH|MEDIUM|NORMAL" pairs, comma-separated.
SHOPIFY_PRIORITY_TAGS=""

# --- Unicommerce / Uniware -------------------------------------------------
# NOTE: tenant base URL, auth scheme and endpoint paths MUST be confirmed
# against your own Uniware account's API documentation before enabling.
UNICOMMERCE_ENABLED=false
UNICOMMERCE_BASE_URL=""
UNICOMMERCE_CLIENT_ID=""
UNICOMMERCE_CLIENT_SECRET=""
UNICOMMERCE_USERNAME=""
UNICOMMERCE_PASSWORD=""
UNICOMMERCE_DEFAULT_FACILITY_CODE=""

# --- Web -------------------------------------------------------------------
API_INTERNAL_URL="http://localhost:3001"

# --- In-app assistant ----------------------------------------------------------
# Set ONE of these. The key stays on the server; the browser never sees it.
# If both are set, ASSISTANT_PROVIDER picks; otherwise Anthropic is preferred.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
ASSISTANT_PROVIDER=""

# Unicommerce through the proxy. These UC_* names take precedence over the
# UNICOMMERCE_* / INTEGRATION_ALLOW_EXTERNAL_WRITES names above.
UC_BASE_URL=""                    # e.g. https://uc-proxy.example.com/uc
UC_AUTH_HEADER="x-proxy-secret"   # header the proxy reads its secret from
UC_PROXY_SECRET=""
UC_READ_ENABLED=false
# Writes are facility switches only, each confirmed by a person. They also need
# "Allow writes" on the Unicommerce connection (Admin > Settings). Writes stay
# refused if confirmation is set to false.
UC_WRITE_ENABLED=false
UC_WRITE_CONFIRMATION_REQUIRED=true
